# =============================================================================
# TenderMarket BACKEND — variables de entorno
# =============================================================================
# Desarrollo local: copia este archivo como .env.local y pega tus credenciales Supabase.
# Vercel: Project Settings → Environment Variables (Production, Preview, Development)
# =============================================================================

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Orígenes permitidos para CORS (separados por coma, sin espacios extra)
# Local + frontend en Vercel. Ejemplo:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://tender-market.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL del frontend (enlaces de verificación y recuperación de contraseña)
# Local:     http://localhost:3000
# Producción: https://tender-market.vercel.app
FRONTEND_URL=http://localhost:3000

# Bucket de imágenes de productos (opcional, default: productos-imagenes)
SUPABASE_PRODUCTOS_BUCKET=productos-imagenes
